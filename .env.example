# ==========================================
# Application Configuration Defaults
# ==========================================
# This file provides default configurations for development.
# In production, replace these with secure environment variables.

# --- Global Settings ---
ENVIRONMENT=development
DEBUG=True

# --- Backend (FastAPI) Settings ---
API_V1_STR=/api/v1
PROJECT_NAME="Employee Attrition Prediction API"
VERSION=4.0.0
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Frontend (Streamlit) Settings ---
# URL where Streamlit will look for the FastAPI backend
BACKEND_URL=https://employee-attrition-xgboost.onrender.com

# --- Database Settings ---
# Using SQLite for development; migrate to Postgres in Production
DATABASE_PATH=employee_predictions.db

# --- Model Artifact Paths ---
MODEL_PATH=models/final_model.pkl
ENCODERS_PATH=models/final_encoders.pkl
FEATURE_NAMES_PATH=models/feature_names.pkl

# --- Optional Cloud Services ---
GEMINI_API_KEY=your_gemini_api_key_here
